{
  "name": "@foldland/strapi-plausible",
  "description": "Show Plausible analytics within Strapi.",
  "version": "2.0.3",
  "license": "MIT",
  "author": {
    "name": "foldland Software GmbH",
    "email": "contact@fold.land",
    "url": "https://fold.land"
  },
  "type": "commonjs",
  "keywords": [
    "strapi",
    "plausible",
    "analytics",
    "plugin"
  ],
  "files": [
    "dist"
  ],
  "strapi": {
    "kind": "plugin",
    "name": "plausible",
    "displayName": "Plausible",
    "description": "Show Plausible analytics within Strapi."
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "strapi-plugin build",
    "check": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm verify",
    "dev": "strapi-plugin watch",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false ",
    "format:write": "biome format --write",
    "link": "strapi-plugin watch:link",
    "lint:check": "biome check --formatter-enabled=false --linter-enabled=true --assist-enabled=true",
    "lint:write": "biome lint --write",
    "test": "echo \"No tests setup\"",
    "verify": "strapi-plugin verify",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p admin/tsconfig.json"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0-rc.29",
    "@strapi/icons": "^2.0.0-rc.29",
    "@strapi/sdk-plugin": "^5.3.2 || ^6.0.0",
    "@strapi/strapi": "^5.19.0",
    "@strapi/types": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "peerDependenciesMeta": {
    "@strapi/types": {
      "optional": true
    }
  },
  "dependencies": {
    "react-intl": "^7.1.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@foldland/biome-configs": "1.4.3",
    "@strapi/sdk-plugin": "6.1.1",
    "@strapi/strapi": "5.51.2",
    "@strapi/typescript-utils": "5.51.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.4",
    "typescript": "5.9.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  }
}
